<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profiles_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/profiles_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/profiles_back" style="@style/Button.Quiet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profiles_back" />
        <TextView style="@style/Text.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s5" android:text="@string/profiles_title" />
        <TextView style="@style/Text.Help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s2" android:text="@string/profiles_help" />
        <TextView android:id="@+id/profiles_busy" style="@style/Text.Help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s3" android:text="@string/profiles_locked" android:textColor="@color/accent" android:visibility="gone" />
        <LinearLayout android:id="@+id/profile_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s5" android:orientation="vertical" />
        <Button android:id="@+id/profile_new" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s5" android:text="@string/profile_new" />
        <Button android:id="@+id/profile_import" style="@style/Button.Quiet" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s3" android:text="@string/profile_import" />
        <Button android:id="@+id/profile_scan" style="@style/Button.Quiet" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/s2" android:text="@string/profile_scan" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Outproxy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/text_dim</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textColorHighlight">@color/accent_pressed</item>
        <item name="android:fontFamily">@font/plex_sans_regular</item>
    </style>

    <style name="Text" />
    <style name="Button" />

    <style name="Text.Display">
        <item name="android:fontFamily">@font/plex_condensed_semibold</item>
        <item name="android:textSize">@dimen/t_display</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body">
        <item name="android:fontFamily">@font/plex_sans_regular</item>
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.Help" parent="Text.Body">
        <item name="android:textSize">@dimen/t_small</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="Text.Section">
        <item name="android:fontFamily">@font/plex_condensed_semibold</item>
        <item name="android:textSize">@dimen/t_label</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Wordmark" parent="Text.Section">
        <item name="android:textColor">@color/accent</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Text.Stat">
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">@dimen/t_stat</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <style name="Text.StatLabel" parent="Text.Section">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:fontFamily">@font/plex_condensed_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Button.Quiet">
        <item name="android:background">@drawable/btn_quiet</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/plex_sans_regular</item>
        <item name="android:textSize">@dimen/t_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:paddingStart">@dimen/s4</item>
        <item name="android:paddingEnd">@dimen/s4</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/border</item>
        <item name="android:background">@color/line</item>
    </style>

    <style name="SegmentCell" parent="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/s2</item>
    </style>

    <style name="SegmentCell.Last">
        <item name="android:layout_marginEnd">0dp</item>
    </style>

    <style name="Segment">
        <item name="android:background">@drawable/segment</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/accent" />
            <corners android:radius="@dimen/radius" />
            <padding android:left="@dimen/s3" android:right="@dimen/s3" android:top="@dimen/s3" android:bottom="@dimen/s3" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/border" android:color="@color/line" />
            <corners android:radius="@dimen/radius" />
            <padding android:left="@dimen/s3" android:right="@dimen/s3" android:top="@dimen/s3" android:bottom="@dimen/s3" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/line" /><corners android:radius="@dimen/radius" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent_pressed" /><corners android:radius="@dimen/radius" /></shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/accent" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/text" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="@dimen/radius" /></shape>
    </item>
</selector>
